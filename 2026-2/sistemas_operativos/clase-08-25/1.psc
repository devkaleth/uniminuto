Proceso clase_25_08
    Definir num Como entero;
    Escribir "Ingrese el numero";
    Leer num;
    Si num == 0 Entonces ->
        Escribir "El nuemro es numero"
    Sino :
        Si num > 0 Entonces ->
            Escribir "El numero es positivo"
        Sino 
            Escribir "El nuemro es positivo"

FinProceso